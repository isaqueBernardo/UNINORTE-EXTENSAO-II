digraph RotaTech {
 graph [rankdir=LR, bgcolor="#f6f9fc", pad="0.42", nodesep="0.5", ranksep="1", splines=ortho, fontname="DejaVu Sans"];
 node [shape=record, style="filled,rounded", fontname="DejaVu Sans", fontsize=10, penwidth=1.4, color="#c4d8e8", fillcolor="#ffffff", fontcolor="#162c51", margin="0.13,0.10"];
 edge [arrowsize=.7, penwidth=1.2, color="#84a3b7", fontname="DejaVu Sans", fontsize=9];
 subgraph cluster_escola { label="ACESSO E ESCOLAS"; fontname="DejaVu Sans Bold"; fontsize=13; fontcolor="#162c51"; style="rounded,filled"; color="#dfebf3"; fillcolor="#eaf2f9";
  schools [label="{SCHOOLS|PK id\lUK code\lname\l}"];
  classrooms [label="{CLASSROOMS|PK id\lFK school_id\lname + school_year\l}"];
  users [label="{USERS|PK id\lFK school_id / classroom_id\lemail + role + xp\l}"];
 }
 subgraph cluster_quiz { label="DESCOBERTA VOCACIONAL"; fontname="DejaVu Sans Bold"; fontsize=13; fontcolor="#162c51"; style="rounded,filled"; color="#d7eeda"; fillcolor="#ecf8eb";
  profiles [label="{CAREER_PROFILES|PK id\lUK slug\lskills JSON\l}"];
  questions [label="{CAREER_QUESTIONS|PK id\ltitulo + posicao\l}"];
  answers [label="{CAREER_ANSWERS|PK id\lFK question_id\lscores JSON\l}"];
  attempts [label="{CAREER_ATTEMPTS|PK id\lFK user_id + result_career_id\lstatus + question_ids\l}"];
  responses [label="{CAREER_RESPONSES|PK id\lFK attempt/question/answer\l}"];
 }
 subgraph cluster_trilhas { label="TRILHAS, MISSOES E CERTIFICACAO"; fontname="DejaVu Sans Bold"; fontsize=13; fontcolor="#162c51"; style="rounded,filled"; color="#dfe3f6"; fillcolor="#f0f2fa";
  paths [label="{LEARNING_PATHS|PK id\lFK career_id / school_id\lslug + published\l}"];
  stages [label="{PATH_STAGES|PK id\lFK path_id\lposition + mission_type\l}"];
  enroll [label="{ENROLLMENTS|PK id\lFK user_id + path_id\lcompleted_at\l}"];
  progress [label="{STAGE_PROGRESS|PK id\lFK enrollment_id + stage_id\lanswer + completed_at\l}"];
  certs [label="{CERTIFICATES|PK id\lFK user_id + enrollment_id\lverification_code\l}"];
  feedback [label="{FEEDBACK|PK id\lFK user_id + path_id\lrating\l}"];
 }
 schools -> classrooms; schools -> users; schools -> paths; classrooms -> users;
 users -> attempts; profiles -> attempts; questions -> answers; attempts -> responses; questions -> responses; answers -> responses;
 profiles -> paths; paths -> stages; users -> enroll; paths -> enroll; enroll -> progress; stages -> progress; enroll -> certs; users -> certs; paths -> feedback; users -> feedback;
}
